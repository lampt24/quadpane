<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QuadPane.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="ChromeBrush" Color="#B3F3F3F3"/>
                    <SolidColorBrush x:Key="TitleSurfaceBrush" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="TitleBorderBrush" Color="#D8D8D8"/>
                    <SolidColorBrush x:Key="TitleTextBrush" Color="#292929"/>
                    <SolidColorBrush x:Key="TabTextBrush" Color="#616161"/>
                    <SolidColorBrush x:Key="TabSelectedTextBrush" Color="#292929"/>
                    <SolidColorBrush x:Key="StatusSurfaceBrush" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="StatusTextBrush" Color="#404040"/>
                    <SolidColorBrush x:Key="StatusMutedTextBrush" Color="#626262"/>
                    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="PaneHeaderBrush" Color="#F9F9F9"/>
                    <SolidColorBrush x:Key="PaneBorderBrush" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#260067C0"/>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#616161"/>
                    <SolidColorBrush x:Key="SegmentBackgroundBrush" Color="#0F000000"/>
                    <SolidColorBrush x:Key="SplitterHoverBrush" Color="#590067C0"/>
                    <SolidColorBrush x:Key="AddressBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TabHoverBrush" Color="#0A000000"/>
                    <SolidColorBrush x:Key="TabBarBrush" Color="#EAEAEA"/>
                    <SolidColorBrush x:Key="TabSelectedBrush" Color="#FFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#191919"/>
                    <SolidColorBrush x:Key="ChromeBrush" Color="#99191919"/>
                    <SolidColorBrush x:Key="TitleSurfaceBrush" Color="#181818"/>
                    <SolidColorBrush x:Key="TitleBorderBrush" Color="#383838"/>
                    <SolidColorBrush x:Key="TitleTextBrush" Color="#DCDCDC"/>
                    <SolidColorBrush x:Key="TabTextBrush" Color="#A8A8A8"/>
                    <SolidColorBrush x:Key="TabSelectedTextBrush" Color="#E6E6E6"/>
                    <SolidColorBrush x:Key="StatusSurfaceBrush" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="StatusTextBrush" Color="#D4D4D4"/>
                    <SolidColorBrush x:Key="StatusMutedTextBrush" Color="#A8A8A8"/>
                    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#202020"/>
                    <SolidColorBrush x:Key="PaneHeaderBrush" Color="#272727"/>
                    <SolidColorBrush x:Key="PaneBorderBrush" Color="#333333"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF"/>
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#334CC2FF"/>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#A0A0A0"/>
                    <SolidColorBrush x:Key="SegmentBackgroundBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="SplitterHoverBrush" Color="#594CC2FF"/>
                    <SolidColorBrush x:Key="AddressBackgroundBrush" Color="#1C1C1C"/>
                    <SolidColorBrush x:Key="TabHoverBrush" Color="#18FFFFFF"/>
                    <SolidColorBrush x:Key="TabBarBrush" Color="#252526"/>
                    <SolidColorBrush x:Key="TabSelectedBrush" Color="#383838"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <!-- Nút chỉ có icon -->
        <Style Selector="Button.icon, ToggleButton.icon">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="ToggleButton.icon:checked, ToggleButton.icon:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Nút trong nhóm chọn bố cục (segmented control) -->
        <Style Selector="ToggleButton.segment">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="ToggleButton.segment:checked, ToggleButton.segment:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Path.layoutIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{Binding $parent[ToggleButton].Foreground}"/>
        </Style>

        <!-- Thẻ panel -->
        <Style Selector="Border.pane">
            <Setter Property="Background" Value="{DynamicResource PaneBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PaneBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.pane.active">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Border.tabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.tabItem.selected">
            <Setter Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
        </Style>
        <Style Selector="Border.tabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource TabHoverBrush}"/>
        </Style>
        <Style Selector="Border.tabItem.selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
        </Style>
        <Style Selector="TextBlock.tabTitle">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TabTextBrush}"/>
        </Style>
        <Style Selector="Border.tabItem.selected TextBlock.tabTitle">
            <Setter Property="Foreground" Value="{DynamicResource TabSelectedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.tabSelect, Button.tabClose, Button.tabAdd, Button.tabAction">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource TabSelectedTextBrush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.tabSelect">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinWidth" Value="55"/>
        </Style>
        <Style Selector="Button.tabClose, Button.tabAdd">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.tabClose:pointerover, Button.tabAdd:pointerover">
            <Setter Property="Background" Value="{DynamicResource TabHoverBrush}"/>
        </Style>
        <Style Selector="Button.tabAction">
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.tabAction.copyPath">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.tabAction:pointerover">
            <Setter Property="Background" Value="{DynamicResource TabHoverBrush}"/>
        </Style>

        <!-- Ô địa chỉ -->
        <Style Selector="TextBox.address">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource AddressBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PaneBorderBrush}"/>
        </Style>

        <Style Selector="TextBox.address.error">
            <Setter Property="BorderBrush" Value="#E81123"/>
        </Style>

        <!-- Splitter mảnh, chỉ hiện khi rê chuột -->
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource SplitterHoverBrush}"/>
        </Style>
    </Application.Styles>
</Application>
