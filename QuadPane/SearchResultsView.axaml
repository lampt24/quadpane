<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:QuadPane"
             x:Class="QuadPane.SearchResultsView" FontSize="12">
    <Grid RowDefinitions="26,*,26" Background="{DynamicResource PaneBackgroundBrush}">
        <Grid Grid.Row="0" ColumnDefinitions="22,2.2*,1.3*,1.2*,70" Margin="4,0"
              Background="{DynamicResource PaneHeaderBrush}">
            <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="0,0,1,1">
                <TextBlock Text="Name" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Column="2" BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="0,0,1,1">
                <TextBlock Text="Date modified" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Column="3" BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="0,0,1,1">
                <TextBlock Text="Type" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Column="4" BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="0,0,1,1">
                <TextBlock Text="Size" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <ListBox x:Name="ResultsList" Grid.Row="1"
                 DoubleTapped="ResultsList_DoubleTapped" KeyDown="ResultsList_KeyDown">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="2,0"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:SearchResult">
                    <Grid ColumnDefinitions="22,2.2*,1.3*,1.2*,70" MinHeight="22" Margin="4,0"
                          ToolTip.Tip="{Binding FullPath}">
                        <Image Grid.Column="0" Source="{Binding IconSource}" Width="16" Height="16"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Margin="6,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding TypeName}" Margin="6,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="4" Text="{Binding SizeText}" Margin="0,0,6,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="ResultStatus" Grid.Row="2" Margin="10,0" VerticalAlignment="Center"
                   FontSize="11" Foreground="{DynamicResource StatusMutedTextBrush}"
                   Text="Nhập từ khóa để tìm kiếm."/>
    </Grid>
</UserControl>
