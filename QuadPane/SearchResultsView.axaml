<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:QuadPane"
             x:Class="QuadPane.SearchResultsView">
    <Grid RowDefinitions="30,*,28" Background="{DynamicResource PaneBackgroundBrush}">
        <Grid Grid.Row="0" ColumnDefinitions="28,2*,3*,85" Margin="8,0"
              Background="{DynamicResource PaneHeaderBrush}">
            <TextBlock Grid.Column="1" Text="Tên" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="Đường dẫn" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="Loại" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </Grid>
        <ListBox x:Name="ResultsList" Grid.Row="1" Margin="4,0"
                 DoubleTapped="ResultsList_DoubleTapped" KeyDown="ResultsList_KeyDown">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="2,0"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:SearchResult">
                    <Grid ColumnDefinitions="28,2*,3*,85" MinHeight="27" Margin="4,0"
                          ToolTip.Tip="{Binding FullPath}">
                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Directory}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource StatusMutedTextBrush}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Kind}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource StatusMutedTextBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="ResultStatus" Grid.Row="2" Margin="10,0" VerticalAlignment="Center"
                   FontSize="11" Foreground="{DynamicResource StatusMutedTextBrush}"
                   Text="Nhập từ khóa để tìm kiếm."/>
    </Grid>
</UserControl>
