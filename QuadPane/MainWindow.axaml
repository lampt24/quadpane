<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QuadPane.MainWindow"
        Title="QuadPane"
        FontFamily="Segoe UI Variable, Segoe UI"
        Icon="/Assets/QuadPane.ico"
        Width="1280" Height="800" MinWidth="830" MinHeight="420"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        TransparencyBackgroundFallback="{DynamicResource WindowFallbackBrush}"
        Background="Transparent">

    <Grid RowDefinitions="32,*,30" Background="{DynamicResource WindowFallbackBrush}">

        <!-- ===== Thanh tiêu đề tự vẽ (nút đóng/thu nhỏ của hệ thống ở góc phải) ===== -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleSurfaceBrush}"
              ColumnDefinitions="Auto,*,Auto,150">
            <Border Grid.ColumnSpan="4" BorderBrush="{DynamicResource TitleBorderBrush}"
                    BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,12,0" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Image Source="/Assets/logo-256.png" Width="16" Height="16"/>
                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="QUAD" FontWeight="Bold" FontSize="12" LetterSpacing="1"
                               Foreground="{DynamicResource TitleTextBrush}"/>
                    <TextBlock Text="PANE" FontWeight="Bold" FontSize="12" LetterSpacing="1"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <TextBlock x:Name="VersionLabel" FontSize="10" VerticalAlignment="Center" Margin="0,2,0,0"
                           Foreground="{DynamicResource StatusMutedTextBrush}"/>
            </StackPanel>

            <TextBox x:Name="SearchBox" Classes="titleSearch" Grid.Column="1" Width="230" Margin="8,0,10,0"
                     FocusAdorner="{x:Null}"
                     HorizontalAlignment="Right" VerticalAlignment="Center"
                     PlaceholderText="Tìm với Everything..." AutomationProperties.Name="Tìm với Everything"
                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- Chọn bố cục -->
                <Border Background="{DynamicResource SegmentBackgroundBrush}" CornerRadius="6" Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <!-- Icon bố cục vẽ bằng vector (hệ toạ độ 16x16), màu theo Foreground của nút -->
                        <ToggleButton x:Name="QuadMode" Classes="segment" ToolTip.Tip="4 khung" Click="Layout_Click">
                            <Path Classes="layoutIcon" Data="M1,1h6v6h-6z M9,1h6v6h-6z M1,9h6v6h-6z M9,9h6v6h-6z"/>
                        </ToggleButton>
                        <ToggleButton x:Name="TripleMode" Classes="segment" ToolTip.Tip="3 khung" Click="Layout_Click">
                            <Path Classes="layoutIcon" Data="M1,1h6v14h-6z M9,1h6v6h-6z M9,9h6v6h-6z"/>
                        </ToggleButton>
                        <ToggleButton x:Name="DualMode" Classes="segment" ToolTip.Tip="2 khung" Click="Layout_Click">
                            <Path Classes="layoutIcon" Data="M1,1h6v14h-6z M9,1h6v14h-6z"/>
                        </ToggleButton>
                        <ToggleButton x:Name="SingleMode" Classes="segment" ToolTip.Tip="1 khung" Click="Layout_Click">
                            <Path Classes="layoutIcon" Data="M1,1h14v14h-14z"/>
                        </ToggleButton>
                    </StackPanel>
                </Border>
                <Button Classes="icon titleIcon" Content="&#xE9A6;" ToolTip.Tip="Chia đều các panel" Click="Equalize_Click"/>
                <Button x:Name="WorkspaceButton" Classes="icon titleIcon" Content="&#xE7C4;"
                        ToolTip.Tip="Workspace: lưu và chuyển nhanh bộ tab + bố cục"
                        AutomationProperties.Name="Workspace" Click="Workspace_Click"/>
                <Button Classes="icon titleIcon" Content="&#xE8FD;"
                        ToolTip.Tip="Bảng lệnh (Ctrl+Shift+P)" AutomationProperties.Name="Bảng lệnh"
                        Click="CommandPalette_Click"/>
                <Button x:Name="ThemeButton" Classes="icon titleIcon" Click="Theme_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== Lưới 4 panel với 2 splitter cắt nhau ===== -->
        <Grid x:Name="PaneGrid" Grid.Row="1" Margin="4"
              ColumnDefinitions="*,1,*" RowDefinitions="*,1,*">
            <GridSplitter x:Name="VSplitter" Grid.Column="1" Grid.RowSpan="3"
                          Width="4" HorizontalAlignment="Center"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" CornerRadius="0"/>
            <GridSplitter x:Name="HSplitter" Grid.Row="1" Grid.ColumnSpan="3"
                          Height="4" VerticalAlignment="Center"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" CornerRadius="0"/>
        </Grid>

        <!-- ===== Thanh trạng thái ===== -->
        <Border Grid.Row="2" MinHeight="30" Background="{DynamicResource StatusSurfaceBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="4,0,10,0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Classes="icon" Content="&#xE713;" Height="26" Width="26" Focusable="True"
                        ToolTip.Tip="Cài đặt (Ctrl+,)" AutomationProperties.Name="Cài đặt" Click="Settings_Click"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="11.5" FontWeight="Medium"
                           Foreground="{DynamicResource StatusTextBrush}" VerticalAlignment="Center"/>
                <Button x:Name="UpdateButton" Grid.Column="2" Classes="update" IsVisible="False"
                        ToolTip.Tip="Tải và cài phiên bản mới" Click="UpdateButton_Click"/>
                <Button x:Name="UpdateErrorButton" Grid.Column="3" Classes="update" IsVisible="False"
                        Content="Lỗi kiểm tra cập nhật" Click="UpdateErrorButton_Click"/>
                <Grid x:Name="GitControls" Grid.Column="5" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="6" Margin="12,2,0,2" HorizontalAlignment="Right"
                      VerticalAlignment="Center" IsVisible="False">
                    <StackPanel x:Name="GitActions" Grid.Column="0" Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Center">
                    <Button Classes="gitAction" ToolTip.Tip="Git fetch"
                            AutomationProperties.Name="Git fetch" Click="GitFetch_Click">
                        <Viewbox Width="14" Height="14">
                            <Path Classes="gitIcon" Data="M20 11a8 8 0 0 0-14-5 M4 4v5h5 M4 13a8 8 0 0 0 14 5 M20 20v-5h-5"/>
                        </Viewbox>
                    </Button>
                    <Button Classes="gitAction" ToolTip.Tip="Git pull (fast-forward only)"
                            AutomationProperties.Name="Git pull" Click="GitPull_Click">
                        <Viewbox Width="14" Height="14">
                            <Path Classes="gitIcon" Data="M12 3v12 M7 10l5 5 5-5 M4 18v3h16v-3"/>
                        </Viewbox>
                    </Button>
                    <Button Classes="gitAction" ToolTip.Tip="Git push"
                            AutomationProperties.Name="Git push" Click="GitPush_Click">
                        <Viewbox Width="14" Height="14">
                            <Path Classes="gitIcon" Data="M12 15V3 M7 8l5-5 5 5 M4 18v3h16v-3"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="GitLogButton" Classes="gitAction" IsVisible="False"
                            ToolTip.Tip="Mở Git log bằng TortoiseGit"
                            AutomationProperties.Name="Xem Git log" Click="GitLog_Click">
                        <Viewbox Width="14" Height="14">
                            <Path Classes="gitIcon" Data="M3 9a9 9 0 1 1 0 6 M3 3v6h6 M12 7v5l3 2"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="GitSwitchButton" Classes="gitAction" IsVisible="False"
                            ToolTip.Tip="Đổi branch bằng TortoiseGit"
                            AutomationProperties.Name="Đổi Git branch" Click="GitSwitch_Click">
                        <Viewbox Width="14" Height="14">
                            <Path Classes="gitIcon" Data="M6 3v12a3 3 0 0 0 3 3h9 M14 14l4 4-4 4 M6 3a2 2 0 1 0 0 4a2 2 0 1 0 0-4"/>
                        </Viewbox>
                    </Button>
                    </StackPanel>
                    <Viewbox Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center">
                        <Path Classes="gitIcon" Stroke="{DynamicResource StatusMutedTextBrush}"
                              Data="M2 12h6 M16 12h6 M12 8a4 4 0 1 0 0 8a4 4 0 1 0 0-8"/>
                    </Viewbox>
                    <TextBlock x:Name="GitCountText" Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                               ToolTip.Tip="Số file đã stage / số file chưa stage, gồm file mới"
                               Foreground="{DynamicResource StatusTextBrush}"/>
                    <Viewbox Grid.Column="3" Width="14" Height="14" Margin="7,0,0,0" VerticalAlignment="Center">
                        <Path Classes="gitIcon" Stroke="{DynamicResource StatusMutedTextBrush}"
                              Data="M6 6v12 M6 6a9 9 0 0 0 9 9 M6 0a3 3 0 1 0 0 6a3 3 0 1 0 0-6 M6 18a3 3 0 1 0 0 6a3 3 0 1 0 0-6 M18 12a3 3 0 1 0 0 6a3 3 0 1 0 0-6"/>
                    </Viewbox>
                    <Viewbox Grid.Column="4" MaxWidth="320" Stretch="Uniform" StretchDirection="DownOnly"
                             VerticalAlignment="Center">
                        <TextBlock x:Name="GitBranchText" FontSize="11" TextWrapping="NoWrap"
                                   Foreground="{DynamicResource StatusTextBrush}"/>
                    </Viewbox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
