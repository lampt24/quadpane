<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QuadPane.MainWindow"
        Title="QuadPane"
        Icon="/Assets/QuadPane.ico"
        Width="1280" Height="800" MinWidth="640" MinHeight="420"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        TransparencyBackgroundFallback="{DynamicResource WindowFallbackBrush}"
        Background="Transparent">

    <Grid RowDefinitions="40,*,30">

        <!-- ===== Thanh tiêu đề tự vẽ (nút đóng/thu nhỏ của hệ thống ở góc phải) ===== -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleSurfaceBrush}"
              ColumnDefinitions="Auto,*,Auto,150">
            <Border Grid.ColumnSpan="4" BorderBrush="{DynamicResource TitleBorderBrush}"
                    BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,16,0" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Image Source="/Assets/logo-256.png" Width="20" Height="20"/>
                <TextBlock Text="QuadPane" FontWeight="Normal" FontSize="14" LetterSpacing="0"
                           Foreground="{DynamicResource TitleTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Chọn bố cục -->
                <Border Background="{DynamicResource SegmentBackgroundBrush}" CornerRadius="7" Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <!-- Icon bố cục vẽ bằng vector (hệ toạ độ 16x16), màu theo Foreground của nút -->
                        <ToggleButton x:Name="QuadMode" Classes="segment" ToolTip.Tip="4 khung" Click="Layout_Click">
                            <Path Classes="layoutIcon" Data="M1,1h6v6h-6z M9,1h6v6h-6z M1,9h6v6h-6z M9,9h6v6h-6z"/>
                        </ToggleButton>
                        <ToggleButton x:Name="TripleMode" Classes="segment" ToolTip.Tip="3 khung" Click="Layout_Click">
                            <Path Classes="layoutIcon" Data="M1,1h6v14h-6z M9,1h6v6h-6z M9,9h6v6h-6z"/>
                        </ToggleButton>
                        <ToggleButton x:Name="DualMode" Classes="segment" ToolTip.Tip="2 khung" Click="Layout_Click">
                            <Path Classes="layoutIcon" Data="M1,1h6v14h-6z M9,1h6v14h-6z"/>
                        </ToggleButton>
                        <ToggleButton x:Name="SingleMode" Classes="segment" ToolTip.Tip="1 khung" Click="Layout_Click">
                            <Path Classes="layoutIcon" Data="M1,1h14v14h-14z"/>
                        </ToggleButton>
                    </StackPanel>
                </Border>
                <Button Classes="icon" Content="&#xE721;" ToolTip.Tip="Tìm kiếm với Everything (Ctrl+F)" Click="Search_Click"/>
                <Button Classes="icon" Content="&#xE9A6;" ToolTip.Tip="Chia đều các panel" Click="Equalize_Click"/>
                <Button x:Name="ThemeButton" Classes="icon" Click="Theme_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== Lưới 4 panel với 2 splitter cắt nhau ===== -->
        <Grid x:Name="PaneGrid" Grid.Row="1" Margin="10,8,10,0"
              ColumnDefinitions="*,8,*" RowDefinitions="*,8,*">
            <GridSplitter x:Name="VSplitter" Grid.Column="1" Grid.RowSpan="3"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" CornerRadius="3"/>
            <GridSplitter x:Name="HSplitter" Grid.Row="1" Grid.ColumnSpan="3"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" CornerRadius="3"/>
        </Grid>

        <!-- ===== Thanh trạng thái ===== -->
        <Border Grid.Row="2" Background="{DynamicResource StatusSurfaceBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="7,2"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="ActiveBadge" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>
                <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="11.5" FontWeight="Medium"
                           Foreground="{DynamicResource StatusTextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource StatusMutedTextBrush}"
                           Text="Ctrl+F  Tìm kiếm    ·    Ctrl+L  Địa chỉ"/>
            </Grid>
        </Border>
    </Grid>
</Window>
