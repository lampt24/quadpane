<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuadPane</RootNamespace>
    <AssemblyName>QuadPane</AssemblyName>
    <Version>0.0.9</Version>
    <!-- Tránh file trung gian cũ bị khóa bởi phần mềm bảo vệ khi build lại. -->
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\generated\</IntermediateOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\QuadPane.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon/logo nhúng vào app (avares://QuadPane/Assets/...) -->
    <AvaloniaResource Include="Assets\QuadPane.ico" />
    <AvaloniaResource Include="Assets\*.png" />
    <Content Include="Assets\EverythingSdk\*.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\EverythingSdk\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Updater.ps1" CopyToOutputDirectory="PreserveNewest" />
    <!-- tools/ chứa script độc lập (dotnet run tools/make-icon.cs), không thuộc app -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- Task thống kê (telemetry) trong Avalonia.BuildServices không nạp được với MSBuild hiện tại
         ("Type must be a type provided by the runtime"). Gói này chỉ phục vụ telemetry nên loại bỏ hẳn. -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

</Project>
