<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:QuadPane"
        x:Class="QuadPane.SearchWindow"
        Title="Tìm kiếm với Everything" Icon="/Assets/QuadPane.ico"
        Width="760" Height="560" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <TextBox x:Name="QueryBox" Grid.Row="0" PlaceholderText="Tìm file hoặc thư mục trên máy..."
                 TextChanged="QueryBox_TextChanged" KeyDown="QueryBox_KeyDown"/>
        <TextBlock Grid.Row="1" Text="Kết quả từ Everything · Enter mở mục được chọn"
                   FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
        <ListBox x:Name="ResultsList" Grid.Row="2" DoubleTapped="ResultsList_DoubleTapped"
                 KeyDown="ResultsList_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:SearchResult">
                    <StackPanel Margin="4,5" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Directory}" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="ResultStatus" Grid.Row="3" FontSize="12"
                   Foreground="{DynamicResource MutedTextBrush}" Text="Nhập từ khóa để tìm kiếm."/>
    </Grid>
</Window>
