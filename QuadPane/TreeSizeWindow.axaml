<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:QuadPane"
        x:Class="QuadPane.TreeSizeWindow"
        Title="Phân tích dung lượng (TreeSize) - QuadPane"
        FontFamily="Segoe UI Variable, Segoe UI"
        Icon="/Assets/QuadPane.ico"
        Width="1080" Height="700" MinWidth="840" MinHeight="480"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        TransparencyBackgroundFallback="{DynamicResource WindowFallbackBrush}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowFallbackBrush}">

    <Window.Styles>
        <Style Selector="TreeView">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TreeViewItem /template/ ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TreeViewItem" x:DataType="local:TreeSizeItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
        <Style Selector="Button.toolbarBtn">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.headerSort">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource StatusMutedTextBrush}"/>
        </Style>
        <Style Selector="Button.headerSort:pointerover">
            <Setter Property="Background" Value="{DynamicResource TabHoverBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="32,Auto,Auto,28,*,32">

        <!-- ===== Row 0: Thanh tiêu đề tự vẽ (đồng bộ MainWindow) ===== -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleSurfaceBrush}"
              ColumnDefinitions="Auto,*,140" Height="32">
            <Border Grid.ColumnSpan="3" BorderBrush="{DynamicResource TitleBorderBrush}"
                    BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,12,0" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Image Source="/Assets/logo-256.png" Width="16" Height="16"/>
                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="QUAD" FontWeight="Bold" FontSize="12" LetterSpacing="1"
                               Foreground="{DynamicResource TitleTextBrush}"/>
                    <TextBlock Text="PANE" FontWeight="Bold" FontSize="12" LetterSpacing="1"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <TextBlock Text="|" FontSize="11" VerticalAlignment="Center" Margin="2,0,2,0"
                           Foreground="{DynamicResource TitleBorderBrush}"/>
                <TextBlock Text="PHÂN TÍCH DUNG LƯỢNG (TREESIZE)" FontSize="10.5" FontWeight="SemiBold"
                           LetterSpacing="0.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource StatusMutedTextBrush}"/>
            </StackPanel>
        </Grid>

        <!-- ===== Row 1: Toolbar ===== -->
        <Border Grid.Row="1" Background="{DynamicResource PaneHeaderBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="DriveSelector" Width="280" Height="30" VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              SelectionChanged="DriveSelector_SelectionChanged"/>
                    <Button x:Name="BrowseButton" Classes="toolbarBtn" Content="Chọn thư mục..."
                            ToolTip.Tip="Phân tích thư mục bất kỳ" Click="BrowseButton_Click"/>
                    <Button x:Name="RefreshButton" Classes="toolbarBtn" Content="Làm mới (F5)"
                            ToolTip.Tip="Quét lại dung lượng" Click="RefreshButton_Click"/>
                    <Button x:Name="ExpandOneLevelButton" Classes="toolbarBtn" Content="Mở 1 cấp"
                            ToolTip.Tip="Mở rộng cấp tiếp theo" Click="ExpandOneLevelButton_Click"/>
                    <Button x:Name="CollapseAllButton" Classes="toolbarBtn" Content="Thu gọn"
                            ToolTip.Tip="Thu gọn toàn bộ cây" Click="CollapseAllButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox x:Name="FilterBox" Width="180" Height="30" VerticalAlignment="Center"
                             VerticalContentAlignment="Center" PlaceholderText="Lọc tên..."
                             TextChanged="FilterBox_TextChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Row 2: Banner Everything index notice (khi chưa bật folder size indexing) ===== -->
        <Border x:Name="EverythingBanner" Grid.Row="2" IsVisible="False"
                Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,0,0,1" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Bật tính năng đọc dung lượng thư mục trong Everything để quét tức thì (&lt;1s) thay vì duyệt tệp."
                               FontSize="12" Foreground="{DynamicResource TitleTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="toolbarBtn" Content="Bật ngay trong Everything"
                        Height="26" Padding="8,2" FontSize="11" Click="EnableEverythingFolderSize_Click"/>
            </Grid>
        </Border>

        <!-- ===== Row 3: Tiêu đề các cột (Header) ===== -->
        <Border Grid.Row="3" Background="{DynamicResource PaneHeaderBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1" Height="28">
            <Grid ColumnDefinitions="*,125,135,130" Margin="28,0,18,0">
                <Button Grid.Column="0" Classes="headerSort" Content="Tên thư mục / Tệp"
                        HorizontalAlignment="Left" Click="SortByName_Click"/>
                <Button Grid.Column="1" Classes="headerSort" Content="Dung lượng"
                        HorizontalAlignment="Right" Margin="0,0,12,0" Click="SortBySize_Click"/>
                <TextBlock Grid.Column="2" Text="Tỉ lệ %" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusMutedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Classes="headerSort" Content="Ngày sửa đổi"
                        HorizontalAlignment="Right" Margin="0,0,8,0" Click="SortByModified_Click"/>
            </Grid>
        </Border>

        <!-- ===== Row 4: Danh sách TreeView ===== -->
        <TreeView x:Name="TreeList" Grid.Row="4" Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  DoubleTapped="TreeList_DoubleTapped" KeyDown="TreeList_KeyDown">
            <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="local:TreeSizeItem" ItemsSource="{Binding Children}">
                    <Grid ColumnDefinitions="*,125,135,130" Margin="0,2,18,2" HorizontalAlignment="Stretch" ClipToBounds="True">
                        <!-- Cột 0: Icon + Tên + Loading -->
                        <Grid Grid.Column="0" ColumnDefinitions="16,*,Auto" ColumnSpacing="6" VerticalAlignment="Center" ClipToBounds="True">
                            <Image Source="{Binding IconSource}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TitleTextBrush}"/>
                            <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="36" Height="3" Margin="6,0,0,0"
                                         VerticalAlignment="Center" IsVisible="{Binding IsLoading}"/>
                        </Grid>

                        <!-- Cột 1: Dung lượng (rộng 125px, không bị lấp số hay đơn vị GB/MB) -->
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Stretch" TextAlignment="Right" ClipToBounds="True" VerticalAlignment="Center"
                                   Margin="0,0,12,0" FontWeight="Medium" FontSize="12"
                                   Foreground="{DynamicResource TitleTextBrush}"/>

                        <!-- Cột 2: Tỉ lệ % trực quan -->
                        <Grid Grid.Column="2" Margin="4,0,12,0" VerticalAlignment="Center" ClipToBounds="True">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" MinWidth="0" Width="119" Height="14" CornerRadius="3"
                                         Background="{DynamicResource SegmentBackgroundBrush}"
                                         Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding PercentText}" FontSize="10" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TitleTextBrush}"/>
                        </Grid>

                        <!-- Cột 3: Ngày sửa đổi -->
                        <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" TextAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,8,0" Foreground="{DynamicResource StatusMutedTextBrush}" FontSize="11.5"/>
                    </Grid>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- ===== Row 5: Thanh trạng thái đáy ===== -->
        <Border Grid.Row="5" Height="32" Background="{DynamicResource StatusSurfaceBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusLabel" Grid.Column="0" FontSize="11.5" FontWeight="Medium"
                           Foreground="{DynamicResource StatusTextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="DeleteFolderButton" Content="Xóa thư mục" Height="24"
                            Padding="10,0" FontSize="11" VerticalAlignment="Center"
                            VerticalContentAlignment="Center" IsEnabled="False" Click="DeleteFolder_Click"/>
                    <Button x:Name="OpenInQuadPaneButton" Content="Mở trong QuadPane" Height="24"
                            Padding="10,0" FontSize="11" VerticalAlignment="Center"
                            VerticalContentAlignment="Center" IsEnabled="False" Click="OpenInQuadPane_Click"/>
                    <Button x:Name="OpenInExplorerButton" Content="Mở trong Explorer" Height="24"
                            Padding="10,0" FontSize="11" VerticalAlignment="Center"
                            VerticalContentAlignment="Center" IsEnabled="False" Click="OpenInExplorer_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
